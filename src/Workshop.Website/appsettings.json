{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "InstallDefaultData": {
        "Languages": {
          "InstallData": "Values",
          "Values": ["en-GB"]
        }
      },
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeAuto"
      },
      "DeliveryApi": {
        "Enabled": true
      },
      "Global": {
        "Id": "4be6be12-fff2-4944-9695-458c243e2ef8",
        "SanitizeTinyMce": true,
        "Smtp": {
          "From": "workshop@example.com",
          "DeliveryMethod": "SpecifiedPickupDirectory"
        }
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true,
        "InstallUnattended": true,
        "UnattendedUserName": "Workshop User",
        "UnattendedUserEmail": "workshop@example.com",
        "UnattendedUserPassword": "password123"
      },
      "Security": {
        "AllowConcurrentLogins": true
      }
    },
    "Forms": {
      "Options": {
        "TrackRenderedFormsStorageMethod": "HttpContextItems"
      }
    }
  },
  "uSync": {
    "Sets": {
      "Default": {
        "HandlerDefaults": {
          "GuidNames": true
        }
      }
    },
    "Settings": {
      "ExportOnSave": "None",
      "ImportOnFirstBoot": true
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Server=localhost;Database=engage-workshop;Integrated Security=true;TrustServerCertificate=true;",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  },
  "DeliveryApiExtensions": {
    "Preview": {
      "Enabled": true,
      "Media": {
        "Enabled": true
      },
      "AllowedUserGroupAliases": []
    },
    "TypedSwagger": {
      "Enabled": true,
      "Mode": "Auto"
    }
  },
  "NextJs": {
    "Revalidate": {
      "Enabled": false,
      "WebHookUrls": "[\"http://localhost:3000/api/revalidate\"]",
      "WebHookSecret": "SOMETHING_SECRET"
    }
  }
}
